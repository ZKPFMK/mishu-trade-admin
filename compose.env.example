# Copy to .env.compose (ignored), replace the placeholder with a URL-safe random hex password.
TRADE_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
SOURCE_MODE=mock
# Production needs an HTTPS reverse proxy. For isolated HTTP evaluation only, explicitly use NODE_ENV=development and COOKIE_SECURE=0.
NODE_ENV=production
COOKIE_SECURE=1
TRADE_ENCRYPTION_KEY=REPLACE_WITH_STABLE_64_HEX_ENCRYPTION_KEY
MANAGEMENT_ENABLED=0
MANAGEMENT_REQUIRE_MFA=1
# SOURCE_COMMAND_TOKEN must differ from SOURCE_READ_TOKEN.
