{
  "name": "mishu-trade-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "start": "tsx apps/api/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "build": "tsc --noEmit && tsc -p apps/admin/tsconfig.json && vite build --config apps/admin/vite.config.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:ui": "tsx scripts/test-ui.ts",
    "test:scale": "tsx scripts/test-scale.ts",
    "local:setup": "tsx scripts/local.ts setup",
    "local:start": "tsx scripts/local.ts start",
    "local:stop": "tsx scripts/local.ts stop",
    "local:restart": "tsx scripts/local.ts restart",
    "openapi": "tsx scripts/openapi.ts",
    "local:status": "tsx scripts/local.ts status",
    "credentials": "tsx scripts/local.ts credentials",
    "db:migrate": "tsx scripts/migrate.ts",
    "operator:create": "tsx scripts/operator-create.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "format": "prettier --write apps packages scripts tests docs *.json *.md"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "18.4.0-beta.17",
    "playwright-core": "1.64.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
